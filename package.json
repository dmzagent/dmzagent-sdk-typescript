{
  "name": "@dmzagent/sdk",
  "version": "0.6.0",
  "description": "TypeScript SDK for DMZAgent \u2014 the codex of trust between minds. Emit agent-stream events, run circuit-breaker checks, verify signed webhooks, govern via the Concordia MCP.",
  "license": "Apache-2.0",
  "author": "Eastern Shore Solutions",
  "homepage": "https://dmzagent.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praeceptor-thesis/dmzagent-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/praeceptor-thesis/dmzagent-sdk-typescript/issues"
  },
  "keywords": [
    "dmzagent",
    "agent",
    "ai",
    "audit",
    "circuit-breaker",
    "observability"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./agent": {
      "types": "./dist/types/agent.d.ts",
      "import": "./dist/esm/agent.js",
      "require": "./dist/cjs/agent.cjs"
    },
    "./concordia": {
      "types": "./dist/types/concordia.d.ts",
      "import": "./dist/esm/concordia.js",
      "require": "./dist/cjs/concordia.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && node -e \"const fs=require('fs');for(const f of ['index','agent','concordia']){const a='dist/cjs/'+f+'.js';const b='dist/cjs/'+f+'.cjs';if(fs.existsSync(a))fs.copyFileSync(a,b);}fs.writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n');\"",
    "build:types": "tsc -p tsconfig.build.types.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run tests/conformance.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dmzagent": {
    "specVersion": "0.9.0"
  }
}
